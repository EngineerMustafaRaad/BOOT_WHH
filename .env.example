# Server Configuration
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# Database Connection (PostgreSQL or Supabase)
# SQLite fallback is also supported for local zero-dependency testing (e.g. file:./dev.db)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wa_moderator?schema=public"

# Authentication & JWT
JWT_SECRET=super-secret-jwt-key-min-32-chars-long-change-in-production
JWT_EXPIRES_IN=7d
ADMIN_DEFAULT_EMAIL=admin@moderator.local
ADMIN_DEFAULT_PASSWORD=AdminSecurePassword123!

# WhatsApp Provider Configuration
# Options: simulator | cloud_api | baileys
WHATSAPP_PROVIDER=simulator

# WhatsApp Cloud API (Meta Official)
WHATSAPP_ACCESS_TOKEN=EAAB...your_meta_system_user_token
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_BUSINESS_ACCOUNT_ID=987654321098765
WHATSAPP_WEBHOOK_VERIFY_TOKEN=my_secure_custom_webhook_verify_token_2026

# Admin WhatsApp for receiving direct alerts
ADMIN_WHATSAPP_NUMBER=+1234567890

# AI Moderation Engine (Optional - OpenAI or Google Gemini)
AI_MODERATION_ENABLED=false
AI_PROVIDER=openai # openai | gemini
AI_API_KEY=sk-proj-...your_api_key_here
AI_MODEL=gpt-4o-mini # or gemini-1.5-flash

# Notification Providers
NOTIFICATION_CHANNELS=whatsapp,telegram # comma-separated: whatsapp, telegram, email, webhook

# Telegram Bot Alerts
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=-1001234567890

# Email Alerts (SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=moderator@yourdomain.com
ALERT_EMAIL_RECIPIENT=security@yourdomain.com

# Webhook Alert Endpoint (e.g. Discord or Custom Endpoint)
WEBHOOK_ALERT_URL=https://discord.com/api/webhooks/...

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
